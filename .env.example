# Server and database.
DATABASE_URL=postgresql://localhost/flurry
PORT=4040
FLURRY_HOST=127.0.0.1
FLURRY_PUBLIC_URL=
FLURRY_SECURE_COOKIES=false

# Repository objects. Use "local" for development or "s3" for a private
# S3-compatible store. All S3 settings are required together.
FLURRY_STORAGE_DRIVER=local
FLURRY_STORE=./data/objects
FLURRY_S3_ENDPOINT=https://nyc3.digitaloceanspaces.com
FLURRY_S3_BUCKET=
FLURRY_S3_REGION=nyc3
FLURRY_S3_PREFIX=flurry
FLURRY_S3_ACCESS_KEY_ID=
FLURRY_S3_SECRET_ACCESS_KEY=
FLURRY_RATE_LIMIT=20
FLURRY_API_RATE_LIMIT=600
FLURRY_GIT_HOSTS=github.com,gitlab.com,bitbucket.org,codeberg.org,git.sr.ht
FLURRY_TRUSTED_PROXIES=
FLURRY_SENDMAIL_PATH=
FLURRY_MAIL_API_URL=
FLURRY_MAIL_API_KEY=
FLURRY_MAIL_FROM=

# Optional account connections for private repository discovery and import.
# Register each callback as https://your-flurry-host/api/source-connections/callback.
FLURRY_GITHUB_CLIENT_ID=
FLURRY_GITHUB_CLIENT_SECRET=
FLURRY_GITLAB_CLIENT_ID=
FLURRY_GITLAB_CLIENT_SECRET=


# Optional Git SSH listener. Generate an Ed25519 host key in this absolute directory.
FLURRY_SSH_PORT=
FLURRY_SSH_HOST_KEY_DIR=
